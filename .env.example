DATABASE_URL="postgresql://usuario:senha@localhost:5432/caeela?schema=public"
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-longo-gerado-localmente"
ADMIN_USUARIO="direcao"
# Senha provisória do primeiro acesso (será trocada no login)
ADMIN_SENHA="troque-por-uma-senha-provisoria"
# Segredo da rotina de limpeza da lixeira (nunca exponha)
LIMPEZA_SEGREDO="troque-por-um-segredo-longo"
# Arquivos (documentos, assinaturas, backups e PDFs). Sem estas variáveis, o
# sistema grava em ./.arquivos no disco e funciona igual em desenvolvimento.
# Na Railway, preencha com os dados do bucket e o modo nuvem liga sozinho.
BUCKET_NOME="caeela-arquivos"
BUCKET_ENDPOINT="https://s3.exemplo.com"
BUCKET_REGION="auto"
BUCKET_KEY="troque-pela-chave-do-bucket"
BUCKET_SECRET="troque-pelo-segredo-do-bucket"
AUTH_TRUST_HOST=false   # true só em desenvolvimento, para testar pelo IP da rede local (celular/tablet)
