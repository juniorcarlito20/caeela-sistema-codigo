!docs/modelos/**/*.docx
# Exceção: agenda fictícia para testar o importador (nomes inventados)
!tests/fixtures/**/*.docx
# Exceção: migrações do Prisma (só estrutura, sem dado pessoal)
!prisma/migrations/**/*.sql
